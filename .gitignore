# ============================================================

# Data

# ============================================================

# Raw and large datasets

data/raw/*
*.csv
*.parquet
*.zip

# Processed data is ignored by default

data/processed/*

# IMPORTANT:

# The API requires this scaler at runtime.

# Keep it in Git so CI/CD and Docker can access it.

!data/processed/
!data/processed/scaler.pkl

# ============================================================

# Models

# ============================================================

# Ignore general serialized models

*.pkl
*.joblib
*.onnx

# IMPORTANT:

# Keep the API preprocessing scaler tracked.

!data/processed/scaler.pkl

# ============================================================

# MLflow

# ============================================================

# Local MLflow tracking artifacts

mlruns/
mlartifacts/
mlflow.db

# MLflow temporary files

.mlflow/

